    {
      "id": "q06",
      "question": "What was my TSH value in my first report?",
      "expect": "answer",
      "files": ["jan"],
      "must_contain": ["2.4 uIU/mL"],
      "answer_must_contain": ["2.4"]
    },
    {
      "id": "q07",
      "question": "What do my reports say about fatigue?",
      "expect": "answer",
      "files": ["jan"],
