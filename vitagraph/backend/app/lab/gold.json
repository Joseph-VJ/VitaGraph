      "expect": "answer",
      "files": ["jan", "jun"],
      "must_contain": ["224 mg/dL", "198 mg/dL"],
      "answer_must_contain": ["224", "198"]
    },
    {
      "id": "q03",
      "question": "What was my hemoglobin in June 2025?",
      "expect": "answer",
      "files": ["jun"],
      "must_contain": ["14.1 g/dL"],
      "answer_must_contain": ["14.1 g/dL"]
    },
    {
      "id": "q04",
      "question": "Which report has a Vitamin B12 result?",
      "expect": "answer",
      "files": ["jun"],
      "must_contain": ["410 pg/mL"],
      "answer_must_contain": ["410"]
    },
    {
      "id": "q05",
      "question": "What was my LDL cholesterol in January and was it flagged?",
      "expect": "answer",
      "files": ["jan"],
      "must_contain": ["148 mg/dL"],
      "answer_must_contain": ["148", "high"]
