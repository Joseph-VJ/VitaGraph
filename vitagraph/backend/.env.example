# VitaGraph backend configuration
# Copy this file to .env and adjust. NEVER commit the real .env file.

# --- Neutral AI generation service boundary ---------------------------------
# The academic plan does not name any provider or model. These values point at
# whatever OpenAI-compatible chat-completions endpoint the team configures.
# When ALLOW_API=false (default) the system runs fully offline and uses the
# local fallback answer composer. Answer generation then reports
# ai_service_status="disabled" instead of failing the request.

ALLOW_API=false
AI_SERVICE_URL=https://agentrouter.org/v1/chat/completions
AI_SERVICE_API_KEY=replace-me
AI_SERVICE_MODEL=deepseek-v4-flash
AI_SERVICE_TIMEOUT_SECONDS=30

# --- Retrieval ---------------------------------------------------------------
TOP_K_RESULTS=5
# Calibrated on the synthetic evaluation set: real evidence matches score
# ~0.49-0.71 with all-MiniLM-L6-v2; best unrelated topical hit was 0.364.
MIN_EVIDENCE_SCORE=0.40

# --- Embedding model (frozen for evaluation reproducibility) -----------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
